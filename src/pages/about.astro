---
import Layout from "../layouts/Layout.astro";
const responsePost = await fetch("https://jsonplaceholder.typicode.com/posts");
const posts = await responsePost.json();
---
<Layout title="About">
    <h1>About</h1>

    <p>About of daniestebDEV</p>
    <p>My name is Daniel Esteban, I am a software developer and I love to create web applications.</p>
    <p>I am a full stack developer, I have experience in frontend and backend technologies.</p>
</Layout>

{
    posts.map((post)=>(
        <div>
            <h2>{post.title}</h2>
            <p>{post.body}</p>
        </div>
    ))
}